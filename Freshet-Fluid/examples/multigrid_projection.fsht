// 2D MAC-grid pressure projection solved with geometric multigrid instead
// of the weighted-Jacobi iteration. A wall-bounded flow with a moving lid is
// projected; the run prints the V-cycle count, the pressure residual and the
// initial/final maximum divergence.
import freshet_fluid;

fn run_multigrid_projection() {
    let nx: u64 = 8; let ny: u64 = 8;
    let cells: u64 = 64;
    let face_count: u64 = 72;
    let u: *f64 = malloc(f64, face_count);
    let v: *f64 = malloc(f64, face_count);
    let pressure: *f64 = malloc(f64, cells);
    let scratch: *f64 = malloc(f64, cells);
    let correction: *f64 = malloc(f64, cells);
    let divergence: *f64 = malloc(f64, cells);
    let work: *f64 = malloc(f64, 112);
    defer free(u); defer free(v); defer free(pressure); defer free(scratch);
    defer free(correction); defer free(divergence); defer free(work);
    for (row in 0..ny) {
        for (col in 0..(nx + 1)) { u[row * (nx + 1) + col] = 0.5 * sin(0.4 * ((col as f64) + (row as f64))); }
    }
    for (row in 0..(ny + 1)) {
        for (col in 0..nx) { v[row * nx + col] = 0.5 * cos(0.3 * (col as f64) - 0.5 * (row as f64)); }
    }
    let boundaries: MACBoundaryConditions2D = MACBoundaryConditions2D {
        left: BoundaryCondition2D { kind: Wall, normal_velocity: 0.0, tangential_velocity: 0.0, pressure_value: 0.0, pressure_gradient: 0.0 },
        right: BoundaryCondition2D { kind: Wall, normal_velocity: 0.0, tangential_velocity: 0.0, pressure_value: 0.0, pressure_gradient: 0.0 },
        bottom: BoundaryCondition2D { kind: Wall, normal_velocity: 0.0, tangential_velocity: 0.0, pressure_value: 0.0, pressure_gradient: 0.0 },
        top: BoundaryCondition2D { kind: Wall, normal_velocity: 0.0, tangential_velocity: 1.0, pressure_value: 0.0, pressure_gradient: 0.0 }
    };
    // two levels (8x8 -> 4x4), 2 pre/post smoothing sweeps, 32 coarse sweeps
    let result: Result<ProjectionReport, FluidError> = project_incompressible_mac_multigrid_2d(
        nx, ny, 0.125, 0.125, 0.01, 1.0, boundaries,
        span(u, face_count), span(v, face_count), span(pressure, cells), span(scratch, cells),
        span(correction, cells), span(divergence, cells), span(work, 112),
        100, 1.0e-8, 2, 2, 2, 32, 0.8);
    match (result) {
        Ok(report) => {
            print("v_cycles="); print_u64(report.iterations);
            print(" pressure_residual="); print_f64(report.pressure_residual, 9);
            print(" initial_div="); print_f64(report.initial_divergence_max, 6);
            print(" final_div="); print_f64(report.final_divergence_max, 9); println();
        }
        Err(error) => { print("multigrid projection failed"); println(); }
    }
}

fn main() {
    run_multigrid_projection();
}
