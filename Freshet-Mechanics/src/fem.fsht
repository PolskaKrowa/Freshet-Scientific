module fem;
import mechanics_common;
import freshet_numerics;

fn checked_matrix_entries(node_count: u64) -> Result<u64, MechanicsError> {
    match (checked_mul(node_count, node_count)) {
        Some(value) => { return Ok(value); }
        None => { return Err(MechanicsSizeOverflow); }
    }
}

// Assemble a 1D axial bar into a dense global stiffness matrix. The caller
// preloads the nodal force vector; this routine preserves it and assembles K.
// Element connectivity uses zero-based node indices. Assembly is serial because
// adjacent elements intentionally scatter-add into shared matrix entries.
pub fn assemble_bar_system_1d(
    node_count: u64, element_count: u64, coordinates_m: Span<f64>,
    node_a: Span<u64>, node_b: Span<u64>, young_modulus_pa: f64, area_m2: f64,
    stiffness: Span<f64>, load: Span<f64>
) -> Result<u64, MechanicsError> {
    if (node_count < 2 || element_count == 0) { return Err(MechanicsInvalidDimension); }
    let matrix_entries: u64 = checked_matrix_entries(node_count)?;
    if (coordinates_m.len != node_count || node_a.len != element_count || node_b.len != element_count ||
        stiffness.len != matrix_entries || load.len != node_count) { return Err(MechanicsDimensionMismatch); }
    if (!mechanics_finite_f64(young_modulus_pa) || !mechanics_finite_f64(area_m2) || young_modulus_pa <= 0.0 || area_m2 <= 0.0) { return Err(InvalidMaterial); }
    for (i in 0..coordinates_m.len) { if (!mechanics_finite_f64(coordinates_m.ptr[i])) { return Err(MechanicsNonFiniteInput); } }
    for (i in 0..load.len) { if (!mechanics_finite_f64(load.ptr[i])) { return Err(MechanicsNonFiniteInput); } }
    let mut k_ptr: *f64 = stiffness.ptr;
    for (i in 0..stiffness.len) { k_ptr[i] = 0.0; }
    for (element in 0..element_count) {
        let a: u64 = node_a.ptr[element]; let b: u64 = node_b.ptr[element];
        if (a >= node_count || b >= node_count || a == b) { return Err(InvalidGeometry); }
        let length: f64 = fabs(coordinates_m.ptr[b] - coordinates_m.ptr[a]);
        if (!mechanics_finite_f64(length)) { return Err(MechanicsNonFiniteResult); }
        if (length <= 0.0) { return Err(InvalidGeometry); }
        let value: f64 = young_modulus_pa * area_m2 / length;
        if (!mechanics_finite_f64(value) || value <= 0.0) { return Err(MechanicsNonFiniteResult); }
        let aa: u64 = a * node_count + a; let ab: u64 = a * node_count + b;
        let ba: u64 = b * node_count + a; let bb: u64 = b * node_count + b;
        k_ptr[aa] = k_ptr[aa] + value; k_ptr[ab] = k_ptr[ab] - value;
        k_ptr[ba] = k_ptr[ba] - value; k_ptr[bb] = k_ptr[bb] + value;
        if (!mechanics_finite_f64(k_ptr[aa]) || !mechanics_finite_f64(k_ptr[ab]) ||
            !mechanics_finite_f64(k_ptr[ba]) || !mechanics_finite_f64(k_ptr[bb])) { return Err(MechanicsNonFiniteResult); }
    }
    return Ok(element_count);
}

// Symmetric Dirichlet elimination. Prescribed values enter RHS before the
// corresponding rows/columns are replaced by identity equations.
pub fn apply_dirichlet_constraints_f64(
    node_count: u64, constrained: Span<bool>, prescribed: Span<f64>,
    stiffness: Span<f64>, load: Span<f64>
) -> Result<u64, MechanicsError> {
    if (constrained.len != node_count || prescribed.len != node_count ||
        load.len != node_count) { return Err(MechanicsDimensionMismatch); }
    let matrix_entries: u64 = checked_matrix_entries(node_count)?;
    if (stiffness.len != matrix_entries) { return Err(MechanicsDimensionMismatch); }
    for (i in 0..stiffness.len) { if (!mechanics_finite_f64(stiffness.ptr[i])) { return Err(MechanicsNonFiniteInput); } }
    for (i in 0..load.len) { if (!mechanics_finite_f64(load.ptr[i])) { return Err(MechanicsNonFiniteInput); } }
    for (i in 0..prescribed.len) { if (!mechanics_finite_f64(prescribed.ptr[i])) { return Err(MechanicsNonFiniteInput); } }
    let mut k_ptr: *f64 = stiffness.ptr; let mut f_ptr: *f64 = load.ptr;
    for (fixed in 0..node_count) {
        if (constrained.ptr[fixed]) {
            let value: f64 = prescribed.ptr[fixed];
            for (row in 0..node_count) {
                if (!constrained.ptr[row]) { f_ptr[row] = f_ptr[row] - k_ptr[row * node_count + fixed] * value; }
            }
            for (i in 0..node_count) {
                k_ptr[fixed * node_count + i] = 0.0;
                k_ptr[i * node_count + fixed] = 0.0;
            }
            k_ptr[fixed * node_count + fixed] = 1.0;
            f_ptr[fixed] = value;
        }
    }
    for (i in 0..stiffness.len) { if (!mechanics_finite_f64(k_ptr[i])) { return Err(MechanicsNonFiniteResult); } }
    for (i in 0..load.len) { if (!mechanics_finite_f64(f_ptr[i])) { return Err(MechanicsNonFiniteResult); } }
    return Ok(node_count);
}

pub fn solve_spd_system_f64(
    n: u64, stiffness: Span<f64>, load: Span<f64>, displacement: Span<f64>,
    residual: Span<f64>, direction: Span<f64>, product: Span<f64>,
    max_iterations: u64, tolerance: f64
) -> Result<CGReport, MechanicsError> {
    let result: Result<CGReport, NumericsError> = freshet_numerics::conjugate_gradient_f64(
        n, stiffness, load, displacement, residual, direction, product, max_iterations, tolerance);
    match (result) {
        Ok(report) => { return Ok(report); }
        Err(error) => { return Err(LinearSolverFailed); }
    }
}
