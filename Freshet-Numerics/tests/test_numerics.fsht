import freshet_numerics;

@test fn dot_is_correct_and_reproducible() {
    let a: [f64; 4] = [1.0, 2.0, 3.0, 4.0];
    let b: [f64; 4] = [4.0, 3.0, 2.0, 1.0];
    let result: Result<f64, NumericsError> = dot_f64(span(a), span(b));
    match (result) {
        Ok(value) => { assert(fabs(value - 20.0) < 1.0e-12); }
        Err(error) => { assert(false); }
    }
}

@test fn matrix_product_writes_row_major_output() {
    let a: [f64; 4] = [1.0, 2.0, 3.0, 4.0];
    let b: [f64; 4] = [5.0, 6.0, 7.0, 8.0];
    let mut c: [f64; 4] = [0.0, 0.0, 0.0, 0.0];
    let result: Result<u64, NumericsError> = matmul_f64(2, 2, 2, span(a), span(b), span(c));
    match (result) {
        Ok(count) => { assert(count == 4); }
        Err(error) => { assert(false); }
    }
    assert(fabs(c[0] - 19.0) < 1.0e-12);
    assert(fabs(c[1] - 22.0) < 1.0e-12);
    assert(fabs(c[2] - 43.0) < 1.0e-12);
    assert(fabs(c[3] - 50.0) < 1.0e-12);
}

@test fn conjugate_gradient_solves_spd_system() {
    // [4 1; 1 3] * x = [1; 2], exact solution [1/11; 7/11].
    let a: [f64; 4] = [4.0, 1.0, 1.0, 3.0];
    let b: [f64; 2] = [1.0, 2.0];
    let mut x: [f64; 2] = [0.0, 0.0];
    let mut r: [f64; 2] = [0.0, 0.0];
    let mut p: [f64; 2] = [0.0, 0.0];
    let mut ap: [f64; 2] = [0.0, 0.0];
    let result: Result<CGReport, NumericsError> = conjugate_gradient_f64(
        2, span(a), span(b), span(x), span(r), span(p), span(ap), 20, 1.0e-12);
    match (result) {
        Ok(report) => { assert(report.converged); }
        Err(error) => { assert(false); }
    }
    assert(fabs(x[0] - (1.0 / 11.0)) < 1.0e-10);
    assert(fabs(x[1] - (7.0 / 11.0)) < 1.0e-10);
}

@test fn mismatched_vector_dimensions_are_reported() {
    let a: [f64; 2] = [1.0, 2.0];
    let b: [f64; 3] = [1.0, 2.0, 3.0];
    let result: Result<f64, NumericsError> = dot_f64(span(a), span(b));
    match (result) {
        Ok(value) => { assert(false); }
        Err(DimensionMismatch) => { assert(true); }
        Err(error) => { assert(false); }
    }
}

@test fn norm_and_axpy_match_reference_values() {
    let x: [f64; 3] = [3.0, 4.0, 0.0];
    let mut y: [f64; 3] = [1.0, 1.0, 1.0];
    let norm: Result<f64, NumericsError> = norm2_f64(span(x));
    match (norm) {
        Ok(value) => { assert(fabs(value - 5.0) < 1.0e-12); }
        Err(error) => { assert(false); }
    }
    let updated: Result<u64, NumericsError> = axpy_f64(2.0, span(x), span(y));
    match (updated) {
        Ok(count) => { assert(count == 3); }
        Err(error) => { assert(false); }
    }
    assert(y[0] == 7.0);
    assert(y[1] == 9.0);
    assert(y[2] == 1.0);
}
