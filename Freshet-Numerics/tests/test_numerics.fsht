import freshet_numerics;

@test fn dot_is_correct_and_reproducible() {
    let a: [f64; 4] = [1.0, 2.0, 3.0, 4.0];
    let b: [f64; 4] = [4.0, 3.0, 2.0, 1.0];
    let result: Result<f64, NumericsError> = dot_f64(span(a), span(b));
    match (result) {
        Ok(value) => { assert(fabs(value - 20.0) < 1.0e-12); }
        Err(error) => { assert(false); }
    }
}

@test fn stable_norm_handles_large_and_small_values() {
    let large: [f64; 2] = [1.0e308, 1.0e308];
    let small: [f64; 2] = [1.0e-308, 1.0e-308];
    let large_norm: Result<f64, NumericsError> = norm2_f64(span(large));
    let small_norm: Result<f64, NumericsError> = norm2_f64(span(small));
    match (large_norm) {
        Ok(value) => { assert(value > 1.4e308 && value < 1.42e308); }
        Err(error) => { assert(false); }
    }
    match (small_norm) {
        Ok(value) => { assert(value > 1.4e-308 && value < 1.42e-308); }
        Err(error) => { assert(false); }
    }
}

@test fn vector_primitives_are_correct() {
    let x: [f64; 3] = [3.0, 4.0, 0.0];
    let mut y: [f64; 3] = [0.0, 0.0, 0.0];
    let scaled: Result<u64, NumericsError> = scale_f64(2.0, span(x), span(y));
    match (scaled) { Ok(n) => { assert(n == 3); } Err(error) => { assert(false); } }
    assert(y[0] == 6.0 && y[1] == 8.0 && y[2] == 0.0);
    let norm: Result<f64, NumericsError> = norm2_f64(span(x));
    match (norm) { Ok(value) => { assert(fabs(value - 5.0) < 1.0e-12); } Err(error) => { assert(false); } }
    let total: Result<f64, NumericsError> = sum_f64(span(x));
    match (total) { Ok(value) => { assert(value == 7.0); } Err(error) => { assert(false); } }
    let maximum: Result<f64, NumericsError> = max_f64(span(x));
    match (maximum) { Ok(value) => { assert(value == 4.0); } Err(error) => { assert(false); } }
}

@test fn dense_matrix_product_writes_row_major_output() {
    let a: [f64; 4] = [1.0, 2.0, 3.0, 4.0];
    let b: [f64; 4] = [5.0, 6.0, 7.0, 8.0];
    let mut c: [f64; 4] = [0.0, 0.0, 0.0, 0.0];
    let result: Result<u64, NumericsError> = blocked_matmul_f64(2, 2, 2, 1, span(a), span(b), span(c));
    match (result) { Ok(count) => { assert(count == 4); } Err(error) => { assert(false); } }
    assert(fabs(c[0] - 19.0) < 1.0e-12);
    assert(fabs(c[1] - 22.0) < 1.0e-12);
    assert(fabs(c[2] - 43.0) < 1.0e-12);
    assert(fabs(c[3] - 50.0) < 1.0e-12);
}

@test fn conjugate_gradient_solves_spd_system() {
    let a: [f64; 4] = [4.0, 1.0, 1.0, 3.0];
    let b: [f64; 2] = [1.0, 2.0];
    let mut x: [f64; 2] = [0.0, 0.0];
    let mut r: [f64; 2] = [0.0, 0.0];
    let mut p: [f64; 2] = [0.0, 0.0];
    let mut ap: [f64; 2] = [0.0, 0.0];
    let result: Result<CGReport, NumericsError> = conjugate_gradient_f64(
        2, span(a), span(b), span(x), span(r), span(p), span(ap), 20, 1.0e-12);
    match (result) { Ok(report) => { assert(report.converged); } Err(error) => { assert(false); } }
    assert(fabs(x[0] - (1.0 / 11.0)) < 1.0e-10);
    assert(fabs(x[1] - (7.0 / 11.0)) < 1.0e-10);
}

@test fn coo_assembly_and_csr_matvec_are_correct() {
    let rows: [u64; 4] = [0, 0, 1, 1];
    let cols: [u64; 4] = [0, 1, 0, 1];
    let values: [f64; 4] = [4.0, 1.0, 1.0, 3.0];
    let mut offsets: [u64; 3] = [0, 0, 0];
    let mut csr_cols: [u64; 4] = [0, 0, 0, 0];
    let mut csr_values: [f64; 4] = [0.0, 0.0, 0.0, 0.0];
    let mut cursor: [u64; 2] = [0, 0];
    let assembled: Result<u64, NumericsError> = coo_to_csr_f64(
        2, 2, span(rows), span(cols), span(values), span(offsets), span(csr_cols), span(csr_values), span(cursor));
    match (assembled) { Ok(nnz) => { assert(nnz == 4); } Err(error) => { assert(false); } }
    let matrix: CSRMatrixF64 = CSRMatrixF64 {
        rows: 2, cols: 2, nnz: 4, row_offsets: span(offsets),
        col_indices: span(csr_cols), values: span(csr_values)
    };
    let x: [f64; 2] = [1.0, 2.0];
    let mut y: [f64; 2] = [0.0, 0.0];
    let product: Result<u64, NumericsError> = csr_matvec_f64(matrix, span(x), span(y));
    match (product) { Ok(n) => { assert(n == 2); } Err(error) => { assert(false); } }
    assert(y[0] == 6.0 && y[1] == 7.0);
}

@test fn stable_norm_reports_true_result_overflow() {
    let values: [f64; 2] = [1.7e308, 1.7e308];
    let result: Result<f64, NumericsError> = norm2_f64(span(values));
    match (result) {
        Ok(value) => { assert(false); }
        Err(NonFiniteResult) => { assert(true); }
        Err(error) => { assert(false); }
    }
}

@test fn finite_validation_rejects_nonfinite_inputs_and_overflow() {
    let huge: f64 = 1.0e308 * 1.0e308;
    let not_a_number: f64 = huge - huge;
    let values: [f64; 2] = [1.0, not_a_number];
    let invalid: Result<f64, NumericsError> = dot_f64(span(values), span(values));
    match (invalid) { Ok(value) => { assert(false); } Err(NonFiniteInput) => { assert(true); } Err(error) => { assert(false); } }
    let a: [f64; 1] = [1.0e308];
    let b: [f64; 1] = [1.0e308];
    let overflow: Result<f64, NumericsError> = dot_f64(span(a), span(b));
    match (overflow) { Ok(value) => { assert(false); } Err(NonFiniteResult) => { assert(true); } Err(error) => { assert(false); } }
}

@test fn matrix_free_cg_uses_the_linear_operator_trait() {
    let matrix_values: [f64; 4] = [4.0, 1.0, 1.0, 3.0];
    let a: DenseMatrixF64 = DenseMatrixF64 { rows: 2, cols: 2, values: span(matrix_values) };
    let b: [f64; 2] = [1.0, 2.0];
    let mut x: [f64; 2] = [0.0, 0.0];
    let mut r: [f64; 2] = [0.0, 0.0];
    let mut p: [f64; 2] = [0.0, 0.0];
    let mut ap: [f64; 2] = [0.0, 0.0];
    let result: Result<CGReport, NumericsError> = conjugate_gradient_operator_f64(
        a, 2, span(b), span(x), span(r), span(p), span(ap), 20, 1.0e-12);
    match (result) { Ok(report) => { assert(report.converged); } Err(error) => { assert(false); } }
}

@test fn conjugate_gradient_rejects_nan_tolerance() {
    let matrix_values: [f64; 1] = [1.0];
    let b: [f64; 1] = [1.0];
    let mut x: [f64; 1] = [0.0]; let mut r: [f64; 1] = [0.0];
    let mut p: [f64; 1] = [0.0]; let mut ap: [f64; 1] = [0.0];
    let infinity: f64 = 1.0e308 * 1.0e308;
    let nan: f64 = infinity - infinity;
    let a: DenseMatrixF64 = DenseMatrixF64 { rows: 1, cols: 1, values: span(matrix_values) };
    let invalid_tolerance: Result<CGReport, NumericsError> = conjugate_gradient_operator_f64(
        a, 1, span(b), span(x), span(r), span(p), span(ap), 4, nan);
    match (invalid_tolerance) {
        Ok(report) => { assert(false); }
        Err(InvalidTolerance) => { assert(true); }
        Err(error) => { assert(false); }
    }
}

@test fn preconditioned_cg_uses_jacobi_and_converges() {
    let matrix_values: [f64; 4] = [4.0, 1.0, 1.0, 3.0];
    let diagonal: [f64; 2] = [4.0, 3.0];
    let mut inverse: [f64; 2] = [0.0, 0.0];
    let inverse_result: Result<u64, NumericsError> = diagonal_inverse_f64(span(diagonal), span(inverse));
    match (inverse_result) { Ok(n) => { assert(n == 2); } Err(error) => { assert(false); } }
    let matrix: DenseMatrixF64 = DenseMatrixF64 { rows: 2, cols: 2, values: span(matrix_values) };
    let preconditioner: JacobiPreconditionerF64 = JacobiPreconditionerF64 { inverse_diagonal: span(inverse) };
    let b: [f64; 2] = [1.0, 2.0];
    let mut x: [f64; 2] = [0.0, 0.0]; let mut r: [f64; 2] = [0.0, 0.0];
    let mut z: [f64; 2] = [0.0, 0.0]; let mut p: [f64; 2] = [0.0, 0.0]; let mut ap: [f64; 2] = [0.0, 0.0];
    let solved: Result<CGReport, NumericsError> = preconditioned_conjugate_gradient_f64(
        matrix, preconditioner, 2, span(b), span(x), span(r), span(z), span(p), span(ap), 20, 1.0e-12);
    match (solved) { Ok(report) => { assert(report.converged); } Err(error) => { assert(false); } }
    assert(fabs(x[0] - 1.0 / 11.0) < 1.0e-10 && fabs(x[1] - 7.0 / 11.0) < 1.0e-10);
}

@test fn bicgstab_solves_nonsymmetric_system() {
    let matrix_values: [f64; 4] = [4.0, 1.0, 2.0, 3.0];
    let matrix: DenseMatrixF64 = DenseMatrixF64 { rows: 2, cols: 2, values: span(matrix_values) };
    let b: [f64; 2] = [1.0, 2.0];
    let mut x: [f64; 2] = [0.0, 0.0]; let mut r: [f64; 2] = [0.0, 0.0];
    let mut rh: [f64; 2] = [0.0, 0.0]; let mut p: [f64; 2] = [0.0, 0.0];
    let mut v: [f64; 2] = [0.0, 0.0]; let mut s: [f64; 2] = [0.0, 0.0]; let mut t: [f64; 2] = [0.0, 0.0];
    let solved: Result<KrylovReport, NumericsError> = bicgstab_f64(
        matrix, 2, span(b), span(x), span(r), span(rh), span(p), span(v), span(s), span(t), 20, 1.0e-12);
    match (solved) { Ok(report) => { assert(report.converged); } Err(error) => { assert(false); } }
    assert(fabs(x[0] - 0.1) < 1.0e-10 && fabs(x[1] - 0.6) < 1.0e-10);
}

@test fn csr_solver_supports_matrix_free_diagonal_operator() {
    let diagonal: [f64; 3] = [2.0, 4.0, 8.0];
    let operator: DiagonalOperatorF64 = DiagonalOperatorF64 { diagonal: span(diagonal) };
    let b: [f64; 3] = [2.0, 8.0, 24.0];
    let mut x: [f64; 3] = [0.0, 0.0, 0.0]; let mut r: [f64; 3] = [0.0, 0.0, 0.0];
    let mut p: [f64; 3] = [0.0, 0.0, 0.0]; let mut ap: [f64; 3] = [0.0, 0.0, 0.0];
    let solved: Result<CGReport, NumericsError> = conjugate_gradient_operator_f64(
        operator, 3, span(b), span(x), span(r), span(p), span(ap), 20, 1.0e-12);
    match (solved) { Ok(report) => { assert(report.converged); } Err(error) => { assert(false); } }
    assert(fabs(x[0] - 1.0) < 1.0e-12 && fabs(x[1] - 2.0) < 1.0e-12 && fabs(x[2] - 3.0) < 1.0e-12);
}


@test fn csr_jacobi_preconditioner_drives_sparse_pcg() {
    let offsets: [u64; 3] = [0, 2, 4];
    let columns: [u64; 4] = [0, 1, 0, 1];
    let values: [f64; 4] = [4.0, 1.0, 1.0, 3.0];
    let matrix: CSRMatrixF64 = CSRMatrixF64 {
        rows: 2, cols: 2, nnz: 4, row_offsets: span(offsets),
        col_indices: span(columns), values: span(values)
    };
    let mut inverse: [f64; 2] = [0.0, 0.0];
    let inverse_result: Result<u64, NumericsError> = csr_inverse_diagonal_f64(matrix, span(inverse));
    match (inverse_result) { Ok(n) => { assert(n == 2); } Err(error) => { assert(false); } }
    let preconditioner: JacobiPreconditionerF64 = JacobiPreconditionerF64 { inverse_diagonal: span(inverse) };
    let b: [f64; 2] = [1.0, 2.0];
    let mut x: [f64; 2] = [0.0, 0.0]; let mut r: [f64; 2] = [0.0, 0.0];
    let mut z: [f64; 2] = [0.0, 0.0]; let mut p: [f64; 2] = [0.0, 0.0]; let mut ap: [f64; 2] = [0.0, 0.0];
    let solved: Result<CGReport, NumericsError> = preconditioned_conjugate_gradient_f64(
        matrix, preconditioner, 2, span(b), span(x), span(r), span(z), span(p), span(ap), 20, 1.0e-12);
    match (solved) { Ok(report) => { assert(report.converged); } Err(error) => { assert(false); } }
    assert(fabs(x[0] - 1.0 / 11.0) < 1.0e-10 && fabs(x[1] - 7.0 / 11.0) < 1.0e-10);
}


@test fn linear_operator_must_report_the_full_output_length() {
    let b: [f64; 2] = [1.0, 1.0];
    let mut x: [f64; 2] = [0.0, 0.0];
    let mut r: [f64; 2] = [0.0, 0.0];
    let mut p: [f64; 2] = [0.0, 0.0];
    let mut ap: [f64; 2] = [0.0, 0.0];
    let solved: Result<CGReport, NumericsError> = conjugate_gradient_operator_f64(
        ShortOperatorF64 {}, 2, span(b), span(x), span(r), span(p), span(ap), 4, 1.0e-8);
    match (solved) {
        Ok(report) => { assert(false); }
        Err(DimensionMismatch) => { assert(true); }
        Err(error) => { assert(false); }
    }
}


@test fn matrix_free_operator_nonfinite_output_is_rejected() {
    let b: [f64; 1] = [1.0];
    let mut x: [f64; 1] = [2.0];
    let mut r: [f64; 1] = [0.0];
    let mut p: [f64; 1] = [0.0];
    let mut ap: [f64; 1] = [0.0];
    let solved: Result<CGReport, NumericsError> = conjugate_gradient_operator_f64(
        OverflowOperatorF64 {}, 1, span(b), span(x), span(r), span(p), span(ap), 4, 1.0e-8);
    match (solved) {
        Ok(report) => { assert(false); }
        Err(NonFiniteResult) => { assert(true); }
        Err(error) => { assert(false); }
    }
}
