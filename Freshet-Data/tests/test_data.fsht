import io;
import freshet_data;

@test fn welford_statistics_and_standard_deviation_are_correct() {
    let values: [f64; 4] = [1.0, 2.0, 3.0, 4.0];
    let result: Result<StatsF64, DataError> = statistics_f64(span(values));
    match (result) {
        Ok(stats) => {
            assert(stats.count == 4);
            assert(fabs(stats.mean - 2.5) < 1.0e-12);
            assert(fabs(stats.variance - 1.25) < 1.0e-12);
            assert(fabs(stats.standard_deviation - sqrt(1.25)) < 1.0e-12);
            assert(stats.minimum == 1.0 && stats.maximum == 4.0);
        }
        Err(error) => { assert(false); }
    }
}

@test fn chan_merge_matches_single_pass_statistics() {
    let first: [f64; 2] = [1.0, 2.0];
    let second: [f64; 2] = [3.0, 4.0];
    let a: Result<StatsF64, DataError> = statistics_f64(span(first));
    let b: Result<StatsF64, DataError> = statistics_f64(span(second));
    let mut merged_a: StatsF64 = StatsF64 { count: 1, mean: 0.0, m2: 0.0, variance: 0.0, standard_deviation: 0.0, minimum: 0.0, maximum: 0.0 };
    let mut merged_b: StatsF64 = StatsF64 { count: 1, mean: 0.0, m2: 0.0, variance: 0.0, standard_deviation: 0.0, minimum: 0.0, maximum: 0.0 };
    match (a) { Ok(value) => { merged_a = value; } Err(error) => { assert(false); } }
    match (b) { Ok(value) => { merged_b = value; } Err(error) => { assert(false); } }
    let merged: Result<StatsF64, DataError> = statistics_merge_f64(merged_a, merged_b);
    match (merged) {
        Ok(stats) => { assert(fabs(stats.mean - 2.5) < 1.0e-12); assert(fabs(stats.variance - 1.25) < 1.0e-12); }
        Err(error) => { assert(false); }
    }
}

@test fn covariance_and_correlation_are_correct() {
    let x: [f64; 3] = [1.0, 2.0, 3.0];
    let y: [f64; 3] = [2.0, 4.0, 6.0];
    let result: Result<CovarianceF64, DataError> = covariance_correlation_f64(span(x), span(y));
    match (result) {
        Ok(stats) => { assert(fabs(stats.covariance - (4.0 / 3.0)) < 1.0e-12); assert(stats.correlation_defined); assert(fabs(stats.correlation - 1.0) < 1.0e-12); }
        Err(error) => { assert(false); }
    }
}

@test fn histogram_accounts_for_edges_and_outliers() {
    let values: [f64; 6] = [-1.0, 0.0, 0.5, 1.0, 2.0, 3.0];
    let mut counts: [u64; 2] = [0, 0];
    let result: Result<HistogramReport, DataError> = histogram_f64(span(values), 0.0, 2.0, span(counts));
    match (result) {
        Ok(report) => { assert(report.below_range == 1); assert(report.above_range == 1); assert(report.in_range == 4); }
        Err(error) => { assert(false); }
    }
    assert(counts[0] == 2 && counts[1] == 2);
}

@test fn histogram_handles_finite_extreme_endpoints_without_range_overflow() {
    let values: [f64; 5] = [-1.0e308, -0.5e308, 0.0, 0.5e308, 1.0e308];
    let mut counts: [u64; 4] = [0, 0, 0, 0];
    let result: Result<HistogramReport, DataError> = histogram_f64(span(values), -1.0e308, 1.0e308, span(counts));
    match (result) { Ok(report) => { assert(report.in_range == 5); } Err(error) => { assert(false); } }
    assert(counts[0] == 1 && counts[1] == 1 && counts[2] == 1 && counts[3] == 2);
}

@test fn zero_variance_covariance_marks_correlation_undefined() {
    let x: [f64; 3] = [2.0, 2.0, 2.0];
    let y: [f64; 3] = [1.0, 2.0, 3.0];
    let result: Result<CovarianceF64, DataError> = covariance_correlation_f64(span(x), span(y));
    match (result) {
        Ok(stats) => { assert(!stats.correlation_defined); }
        Err(error) => { assert(false); }
    }
}

@test fn affine_transform_is_elementwise() {
    let input: [f64; 3] = [1.0, 2.0, 3.0];
    let mut output: [f64; 3] = [0.0, 0.0, 0.0];
    let result: Result<u64, DataError> = affine_transform_f64(span(input), span(output), 2.0, 1.0);
    match (result) { Ok(count) => { assert(count == 3); } Err(error) => { assert(false); } }
    assert(output[0] == 3.0 && output[1] == 5.0 && output[2] == 7.0);
}

@test fn finite_validation_rejects_infinity_and_nan() {
    let infinity: f64 = 1.0e308 * 1.0e308;
    let values: [f64; 2] = [1.0, infinity];
    let result: Result<StatsF64, DataError> = statistics_f64(span(values));
    match (result) { Ok(stats) => { assert(false); } Err(NonFiniteInput) => { assert(true); } Err(error) => { assert(false); } }
}

@test fn chunk_planning_covers_tail() {
    let count: Result<u64, DataError> = chunk_count(1001, 256);
    match (count) { Ok(value) => { assert(value == 4); } Err(error) => { assert(false); } }
    let offset: Result<u64, DataError> = chunk_offset(3, 256);
    match (offset) { Ok(value) => { assert(value == 768); } Err(error) => { assert(false); } }
    let length: Result<u64, DataError> = chunk_length(1001, 768, 256);
    match (length) { Ok(value) => { assert(value == 233); } Err(error) => { assert(false); } }
}

@test fn binary_blocks_round_trip_with_explicit_byte_order() {
    let input: [f64; 3] = [1.25, -2.5, 9.0];
    let mut scratch: [f64; 3] = [0.0, 0.0, 0.0];
    let mut output: [f64; 3] = [0.0, 0.0, 0.0];
    let opened_writer: Result<BinaryFile, DataError> = binary_open_write("data_binary_test.bin", BigEndian);
    let mut writer: BinaryFile = BinaryFile { handle: nil, byte_order: BigEndian, writable: true };
    match (opened_writer) { Ok(file) => { writer = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut writer);
    let wrote: Result<u64, DataError> = binary_write_f64(&mut writer, span(input), span(scratch));
    match (wrote) { Ok(count) => { assert(count == 3); } Err(error) => { assert(false); } }
    binary_close(&mut writer);
    let opened_reader: Result<BinaryFile, DataError> = binary_open_read("data_binary_test.bin", BigEndian);
    let mut reader: BinaryFile = BinaryFile { handle: nil, byte_order: BigEndian, writable: false };
    match (opened_reader) { Ok(file) => { reader = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut reader);
    let read: Result<u64, DataError> = binary_read_f64(&mut reader, span(output));
    match (read) { Ok(count) => { assert(count == 3); } Err(error) => { assert(false); } }
    assert(output[0] == input[0] && output[1] == input[1] && output[2] == input[2]);
    binary_close(&mut reader);
    io::remove("data_binary_test.bin");
}

@test fn covariance_accumulators_merge_by_chunk() {
    let mut a: CovarianceAccumulatorF64 = covariance_accumulator_empty_f64();
    let mut b: CovarianceAccumulatorF64 = covariance_accumulator_empty_f64();
    let a1: Result<CovarianceAccumulatorF64, DataError> = covariance_accumulator_update_f64(a, 1.0, 2.0);
    match (a1) { Ok(value) => { a = value; } Err(error) => { assert(false); } }
    let a2: Result<CovarianceAccumulatorF64, DataError> = covariance_accumulator_update_f64(a, 2.0, 4.0);
    match (a2) { Ok(value) => { a = value; } Err(error) => { assert(false); } }
    let b1: Result<CovarianceAccumulatorF64, DataError> = covariance_accumulator_update_f64(b, 3.0, 6.0);
    match (b1) { Ok(value) => { b = value; } Err(error) => { assert(false); } }
    let b2: Result<CovarianceAccumulatorF64, DataError> = covariance_accumulator_update_f64(b, 4.0, 8.0);
    match (b2) { Ok(value) => { b = value; } Err(error) => { assert(false); } }
    let merged: Result<CovarianceAccumulatorF64, DataError> = covariance_accumulator_merge_f64(a, b);
    match (merged) {
        Ok(accumulator) => {
            let report: Result<CovarianceF64, DataError> = covariance_accumulator_finish_f64(accumulator);
            match (report) { Ok(stats) => { assert(stats.correlation_defined); assert(fabs(stats.correlation - 1.0) < 1.0e-12); assert(fabs(stats.covariance - 2.5) < 1.0e-12); } Err(error) => { assert(false); } }
        }
        Err(error) => { assert(false); }
    }
}

@test fn welford_detects_finite_input_intermediate_overflow() {
    let values: [f64; 2] = [1.0e308, -1.0e308];
    let result: Result<StatsF64, DataError> = statistics_f64(span(values));
    match (result) { Ok(stats) => { assert(false); } Err(NonFiniteResult) => { assert(true); } Err(error) => { assert(false); } }
}

@test fn binary_io_supports_f32_i64_and_u64_with_endian_conversion() {
    let input_f32: [f32; 3] = [1.5, -2.25, 9.0];
    let mut scratch_f32: [f32; 3] = [0.0, 0.0, 0.0];
    let mut output_f32: [f32; 3] = [0.0, 0.0, 0.0];
    let opened_f32: Result<BinaryFile, DataError> = binary_open_write("data_f32_test.bin", LittleEndian);
    let mut writer_f32: BinaryFile = BinaryFile { handle: nil, byte_order: LittleEndian, writable: true };
    match (opened_f32) { Ok(file) => { writer_f32 = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut writer_f32);
    let wrote_f32: Result<u64, DataError> = binary_write_f32(&mut writer_f32, span(input_f32), span(scratch_f32));
    match (wrote_f32) { Ok(n) => { assert(n == 3); } Err(error) => { assert(false); } }
    binary_close(&mut writer_f32);
    let opened_f32_reader: Result<BinaryFile, DataError> = binary_open_read("data_f32_test.bin", LittleEndian);
    let mut reader_f32: BinaryFile = BinaryFile { handle: nil, byte_order: LittleEndian, writable: false };
    match (opened_f32_reader) { Ok(file) => { reader_f32 = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut reader_f32);
    let read_f32: Result<u64, DataError> = binary_read_f32(&mut reader_f32, span(output_f32));
    match (read_f32) { Ok(n) => { assert(n == 3); } Err(error) => { assert(false); } }
    assert(output_f32[0] == input_f32[0] && output_f32[1] == input_f32[1] && output_f32[2] == input_f32[2]);
    binary_close(&mut reader_f32);
    io::remove("data_f32_test.bin");

    let input_i64: [i64; 3] = [1, -2, 9000000000];
    let mut scratch_i64: [i64; 3] = [0, 0, 0];
    let mut output_i64: [i64; 3] = [0, 0, 0];
    let opened_i64: Result<BinaryFile, DataError> = binary_open_write("data_i64_test.bin", BigEndian);
    let mut writer_i64: BinaryFile = BinaryFile { handle: nil, byte_order: BigEndian, writable: true };
    match (opened_i64) { Ok(file) => { writer_i64 = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut writer_i64);
    let wrote_i64: Result<u64, DataError> = binary_write_i64(&mut writer_i64, span(input_i64), span(scratch_i64));
    match (wrote_i64) { Ok(n) => { assert(n == 3); } Err(error) => { assert(false); } }
    binary_close(&mut writer_i64);
    let opened_i64_reader: Result<BinaryFile, DataError> = binary_open_read("data_i64_test.bin", BigEndian);
    let mut reader_i64: BinaryFile = BinaryFile { handle: nil, byte_order: BigEndian, writable: false };
    match (opened_i64_reader) { Ok(file) => { reader_i64 = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut reader_i64);
    let read_i64: Result<u64, DataError> = binary_read_i64(&mut reader_i64, span(output_i64));
    match (read_i64) { Ok(n) => { assert(n == 3); } Err(error) => { assert(false); } }
    assert(output_i64[0] == input_i64[0] && output_i64[1] == input_i64[1] && output_i64[2] == input_i64[2]);
    binary_close(&mut reader_i64);
    io::remove("data_i64_test.bin");

    let input_u64: [u64; 3] = [1, 9223372036854775808, 18446744073709551615];
    let mut scratch_u64: [u64; 3] = [0, 0, 0];
    let mut output_u64: [u64; 3] = [0, 0, 0];
    let opened_u64: Result<BinaryFile, DataError> = binary_open_write("data_u64_test.bin", LittleEndian);
    let mut writer_u64: BinaryFile = BinaryFile { handle: nil, byte_order: LittleEndian, writable: true };
    match (opened_u64) { Ok(file) => { writer_u64 = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut writer_u64);
    let wrote_u64: Result<u64, DataError> = binary_write_u64(&mut writer_u64, span(input_u64), span(scratch_u64));
    match (wrote_u64) { Ok(n) => { assert(n == 3); } Err(error) => { assert(false); } }
    binary_close(&mut writer_u64);
    let opened_u64_reader: Result<BinaryFile, DataError> = binary_open_read("data_u64_test.bin", LittleEndian);
    let mut reader_u64: BinaryFile = BinaryFile { handle: nil, byte_order: LittleEndian, writable: false };
    match (opened_u64_reader) { Ok(file) => { reader_u64 = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut reader_u64);
    let read_u64: Result<u64, DataError> = binary_read_u64(&mut reader_u64, span(output_u64));
    match (read_u64) { Ok(n) => { assert(n == 3); } Err(error) => { assert(false); } }
    assert(output_u64[0] == input_u64[0] && output_u64[1] == input_u64[1] && output_u64[2] == input_u64[2]);
    binary_close(&mut reader_u64);
    io::remove("data_u64_test.bin");
}

@test fn typed_record_batch_columns_are_zero_copy_and_validated() {
    let storage: *f64 = malloc(f64, 4);
    defer free(storage);
    storage[0] = 1.5; storage[1] = 2.5; storage[2] = 10.0; storage[3] = 20.0;
    let columns: [ColumnSchema; 2] = [
        ColumnSchema { name: "time", data_type: F64, byte_offset: 0 },
        ColumnSchema { name: "pressure", data_type: F64, byte_offset: 16 }
    ];
    let bytes: Span<u8> = span(storage as *u8, 32);
    let batch: RecordBatchView = RecordBatchView { row_count: 2, columns: span(columns), payload: bytes };
    let valid: Result<u64, DataError> = validate_record_batch(batch);
    match (valid) { Ok(rows) => { assert(rows == 2); } Err(error) => { assert(false); } }
    let time_column: Result<Span<f64>, DataError> = record_batch_f64_column(batch, 0);
    let pressure_column: Result<Span<f64>, DataError> = record_batch_f64_column(batch, 1);
    match (time_column) { Ok(values) => { assert(values[0] == 1.5 && values[1] == 2.5); } Err(error) => { assert(false); } }
    match (pressure_column) { Ok(values) => { assert(values[0] == 10.0 && values[1] == 20.0); } Err(error) => { assert(false); } }
    let wrong_type: Result<Span<i64>, DataError> = record_batch_i64_column(batch, 0);
    match (wrong_type) { Ok(values) => { assert(false); } Err(InvalidSchema) => { assert(true); } Err(error) => { assert(false); } }
}

@test fn typed_record_batch_views_cover_all_scalar_column_types() {
    let storage: *u64 = malloc(u64, 7);
    defer free(storage);
    let doubles: *f64 = storage as *f64;
    let floats: *f32 = storage as *f32;
    let signed: *i64 = storage as *i64;
    doubles[0] = 1.5; doubles[1] = 2.5;
    floats[4] = 3.25; floats[5] = 4.5;
    signed[3] = 11; signed[4] = 22;
    storage[5] = 33; storage[6] = 44;
    let columns: [ColumnSchema; 4] = [
        ColumnSchema { name: "double", data_type: F64, byte_offset: 0 },
        ColumnSchema { name: "float", data_type: F32, byte_offset: 16 },
        ColumnSchema { name: "signed", data_type: I64, byte_offset: 24 },
        ColumnSchema { name: "unsigned", data_type: U64, byte_offset: 40 }
    ];
    let payload: Span<u8> = span(storage as *u8, 56);
    let batch: RecordBatchView = RecordBatchView { row_count: 2, columns: span(columns), payload: payload };
    let double_view: Result<Span<f64>, DataError> = record_batch_f64_column(batch, 0);
    let float_view: Result<Span<f32>, DataError> = record_batch_f32_column(batch, 1);
    let signed_view: Result<Span<i64>, DataError> = record_batch_i64_column(batch, 2);
    let unsigned_view: Result<Span<u64>, DataError> = record_batch_u64_column(batch, 3);
    match (double_view) { Ok(values) => { assert(values[0] == 1.5 && values[1] == 2.5); } Err(error) => { assert(false); } }
    match (float_view) { Ok(values) => { assert(values[0] == 3.25 && values[1] == 4.5); } Err(error) => { assert(false); } }
    match (signed_view) { Ok(values) => { assert(values[0] == 11 && values[1] == 22); } Err(error) => { assert(false); } }
    match (unsigned_view) { Ok(values) => { assert(values[0] == 33 && values[1] == 44); } Err(error) => { assert(false); } }
}

@test fn affine_transform_reports_intermediate_overflow() {
    let input: [f64; 2] = [1.0e308, 1.0];
    let mut output: [f64; 2] = [0.0, 0.0];
    let result: Result<u64, DataError> = affine_transform_f64(span(input), span(output), 2.0, 0.0);
    match (result) { Ok(n) => { assert(false); } Err(NonFiniteResult) => { assert(true); } Err(error) => { assert(false); } }
}


@test fn statistics_rejects_nan_values_explicitly() {
    let infinity: f64 = 1.0e308 * 1.0e308;
    let nan: f64 = infinity - infinity;
    let values: [f64; 2] = [1.0, nan];
    let result: Result<StatsF64, DataError> = statistics_f64(span(values));
    match (result) { Ok(stats) => { assert(false); } Err(NonFiniteInput) => { assert(true); } Err(error) => { assert(false); } }
}

@test fn binary_transform_reuses_buffers_and_writes_expected_values() {
    let input: [f64; 4] = [1.0, -2.0, 3.5, 8.0];
    let mut write_scratch: [f64; 4] = [0.0, 0.0, 0.0, 0.0];
    let opened: Result<BinaryFile, DataError> = binary_open_write("data_transform_input.bin", BigEndian);
    let mut writer: BinaryFile = BinaryFile { handle: nil, byte_order: BigEndian, writable: true };
    match (opened) { Ok(file) => { writer = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut writer);
    let wrote: Result<u64, DataError> = binary_write_f64(&mut writer, span(input), span(write_scratch));
    match (wrote) { Ok(n) => { assert(n == 4); } Err(error) => { assert(false); } }
    binary_flush(&mut writer);
    binary_close(&mut writer);

    let mut input_buffer: [f64; 4] = [0.0, 0.0, 0.0, 0.0];
    let mut output_buffer: [f64; 4] = [0.0, 0.0, 0.0, 0.0];
    let mut transform_scratch: [f64; 4] = [0.0, 0.0, 0.0, 0.0];
    let processor: AffineTransformF64 = AffineTransformF64 { scale: 2.0, offset: 1.0 };
    let transformed: Result<u64, DataError> = process_binary_f64_chunks(
        processor, "data_transform_input.bin", "data_transform_output.bin", BigEndian,
        span(input_buffer), span(output_buffer), span(transform_scratch));
    match (transformed) { Ok(n) => { assert(n == 4); } Err(error) => { assert(false); } }
    let opened_output: Result<BinaryFile, DataError> = binary_open_read("data_transform_output.bin", BigEndian);
    let mut reader: BinaryFile = BinaryFile { handle: nil, byte_order: BigEndian, writable: false };
    match (opened_output) { Ok(file) => { reader = file; } Err(error) => { assert(false); } }
    defer binary_close(&mut reader);
    let mut output: [f64; 4] = [0.0, 0.0, 0.0, 0.0];
    let read: Result<u64, DataError> = binary_read_f64(&mut reader, span(output));
    match (read) { Ok(n) => { assert(n == 4); } Err(error) => { assert(false); } }
    assert(output[0] == 3.0 && output[1] == -3.0 && output[2] == 8.0 && output[3] == 17.0);
    binary_close(&mut reader);
    io::remove("data_transform_input.bin");
    io::remove("data_transform_output.bin");
}

@test fn text_scan_streams_and_closes_reader() {
    let opened: Result<Writer, IoError> = io::writer_open("data_lines_test.txt");
    let mut writer: Writer = Writer { handle: -1 };
    match (opened) { Ok(file) => { writer = file; } Err(error) => { assert(false); } }
    let line1: Result<usize, IoError> = io::writer_write(&mut writer, "1.0\n");
    let line2: Result<usize, IoError> = io::writer_write(&mut writer, "2.0\n");
    let line3: Result<usize, IoError> = io::writer_write(&mut writer, "3.0\n");
    match (line1) { Ok(n) => { assert(n == 4); } Err(error) => { assert(false); } }
    match (line2) { Ok(n) => { assert(n == 4); } Err(error) => { assert(false); } }
    match (line3) { Ok(n) => { assert(n == 4); } Err(error) => { assert(false); } }
    io::writer_flush(&mut writer);
    io::writer_close(&mut writer);
    let scanned: Result<StatsF64, DataError> = scan_f64_lines("data_lines_test.txt");
    match (scanned) {
        Ok(stats) => { assert(stats.count == 3); assert(fabs(stats.mean - 2.0) < 1.0e-12); }
        Err(error) => { assert(false); }
    }
    io::remove("data_lines_test.txt");
}
