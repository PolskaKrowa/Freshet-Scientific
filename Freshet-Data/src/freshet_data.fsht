impl BinaryChunkTransformF64 for AffineTransformF64 {
    fn transform(processor: Self, input: Span<f64>, output: Span<f64>) -> Result<u64, DataError> {
        return affine_transform_f64(input, output, processor.scale, processor.offset);
    }
}

// Reusable bounded-memory reader -> chunk buffer -> decode/validate ->
// statically-dispatched transform -> numerical work -> writer pipeline.
// All three workspaces are caller-owned and reused for every block.
pub fn process_binary_f64_chunks<T: BinaryChunkTransformF64>(
    processor: T, input_path: str, output_path: str, order: ByteOrder,
    input_buffer: Span<f64>, output_buffer: Span<f64>, write_scratch: Span<f64>
) -> Result<u64, DataError> {
    if (input_buffer.len == 0 || output_buffer.len < input_buffer.len || write_scratch.len < input_buffer.len) { return Err(InvalidChunkSize); }
    if (input_buffer.ptr == output_buffer.ptr || input_buffer.ptr == write_scratch.ptr || output_buffer.ptr == write_scratch.ptr) { return Err(DimensionMismatch); }
    if (str_eq(input_path, output_path)) { return Err(InvalidRecord); }
    let mut reader: BinaryFile = binary_open_read(input_path, order)?;
    defer binary_close(&mut reader);
    let mut writer: BinaryFile = binary_open_write(output_path, order)?;
    defer binary_close(&mut writer);
    let mut total: u64 = 0;
    while (true) {
        let read_count: u64 = binary_read_f64(&mut reader, input_buffer)?;
        if (read_count == 0) { break; }
        let input_chunk: Span<f64> = span(input_buffer.ptr, read_count);
        let output_chunk: Span<f64> = span(output_buffer.ptr, read_count);
        let scratch_chunk: Span<f64> = span(write_scratch.ptr, read_count);
        validate_finite_f64(input_chunk)?;
        let transformed: u64 = BinaryChunkTransformF64::transform(processor, input_chunk, output_chunk)?;
        if (transformed != read_count) { return Err(DimensionMismatch); }
        validate_finite_result_f64(output_chunk)?;
        binary_write_f64(&mut writer, output_chunk, scratch_chunk)?;
        total = checked_count(checked_add(total, read_count))?;
    }
    binary_flush(&mut writer)?;
    return Ok(total);
}

// Convenience affine processor retained for simple file-to-file workflows.
pub fn transform_binary_f64_file(
    input_path: str, output_path: str, order: ByteOrder, scale: f64, offset: f64,
    input_buffer: Span<f64>, output_buffer: Span<f64>, write_scratch: Span<f64>
) -> Result<u64, DataError> {
    if (!finite_f64(scale) || !finite_f64(offset)) { return Err(NonFiniteInput); }
    let processor: AffineTransformF64 = AffineTransformF64 { scale: scale, offset: offset };
    return process_binary_f64_chunks(processor, input_path, output_path, order,
                                     input_buffer, output_buffer, write_scratch);
}

// Streaming text adapter: one finite f64 per line. The reader is always
// closed, including on EOF and on early Result propagation.
pub fn scan_f64_lines(path: str) -> Result<StatsF64, DataError> {
    let opened: Result<Reader, IoError> = io::reader_open(path);
    let mut reader: Reader = Reader { handle: -1 };
    match (opened) {
        Ok(handle) => { reader = handle; }
        Err(error) => { return Err(Io(error)); }
    }
    defer io::reader_close(&mut reader);
    let mut count: u64 = 0;
    let mut mean: f64 = 0.0;
    let mut m2: f64 = 0.0;
    let mut minimum: f64 = 0.0;
    let mut maximum: f64 = 0.0;
    while (true) {
        let next_line: Result<String, IoError> = io::reader_read_line(&mut reader);
        match (next_line) {
            Ok(line) => {
                let parsed: Result<f64, ParseError> = parse_f64(str_of(&line));
                let mut value: f64 = 0.0;
                match (parsed) {
                    Ok(number) => { value = number; }
                    Err(error) => { return Err(InvalidRecord); }
                }
                if (!finite_f64(value)) { return Err(InvalidRecord); }
                count = checked_count(checked_add(count, 1))?;
                if (count == 1) { minimum = value; maximum = value; }
                if (value < minimum) { minimum = value; }
                if (value > maximum) { maximum = value; }
                let delta: f64 = value - mean;
                mean = mean + delta / (count as f64);
                m2 = m2 + delta * (value - mean);
                if (!finite_f64(mean) || !finite_f64(m2)) { return Err(NonFiniteResult); }
            }
            Err(Eof) => { break; }
            Err(error) => { return Err(Io(error)); }
        }
    }
    if (count == 0) { return Err(EmptyInput); }
    let variance: f64 = m2 / (count as f64);
    if (!finite_f64(variance) || variance < 0.0) { return Err(NonFiniteResult); }
    return Ok(StatsF64 {
        count: count, mean: mean, m2: m2, variance: variance,
        standard_deviation: sqrt(variance), minimum: minimum, maximum: maximum
    });
}
